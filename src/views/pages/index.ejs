<%- include('../partials/header'); %>
<section class="hero">
  <div class="hero-body">
    <h1 class="title is-size-0 text-prewrap"><%= heroSection.title %></h1>
    <div class="content">
      <ul id="con" class="block">
        <% for(let i = 0; i < heroSection.bullets.length; i++) { %>
          <li class="block invisible"><%= heroSection.bullets[i] %></li>
        <% } %>
      </ul>
    </div>
    <img src="<%= heroSection.image.href %>" alt="">
    <button class="button">
      <a href="#demo-form" style="color: var(--bulma-body-color);"><%= heroSection.button.text %></a>
    </button>
  </div>
</section>
<section class="section">
  <h2 class="title has-text-centered"><%= featureSection.title %></h2>
  <% for(let i = 0; i < featureSection.cards.length; i++) { %>
    <div class="columns is-vcentered">
      <% if(i % 2 == 0) { %>
        <div class="column">
          <figure class="image">
            <img src="<%= featureSection.cards[i].href %>" />
          </figure>
        </div>
        <div class="column is-offset-2">
          <h4 class="title is-4 centered"><%= featureSection.cards[i].title %></h4>
          <div class="content">
            <%= featureSection.cards[i].text %>
          </div>
        </div>
      <% } else { %>
        <div class="column">
          <h4 class="title is-4 centered"><%= featureSection.cards[i].title %></h4>
          <div class="content">
            <%= featureSection.cards[i].text %>
          </div>
        </div>
        <div class="column is-offset-2">
          <figure class="image">
            <img src="<%= featureSection.cards[i].href %>" />
          </figure>
        </div>
      <% } %>
      </div>
  <% } %>
</section>
<% productSection.forEach((section) => { %>
  <section class="section">
    <div class="content">
      <h2 class="has-text-centered"><%= section.title %></h2>
      <div class="columns">
        <div class="column is-3 is-offset-1">
          <% for(let i = 0; i < section.bullets.length; i++) { %>
            <% if(i % 2 == 0) { %>
              <h4><%= section.features[i] %></h4>
              <p><%= section.bullets[i] %></p>
            <% } %>
          <% } %>
        </div>
        <div class="column is-3 is-offset-4">
          <% for(let i = 0; i < section.bullets.length; i++) { %>
            <% if(i & 1 == 1) { %>
              <h4><%= section.features[i] %></h4>
              <p><%= section.bullets[i] %></p>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>
  </section>
<% }); %>
<section class="section">
  <form id="demo-form" method="post">
    <h2 class="title"><%= demoSection.title %></h2>
    <div class="field">
      <label for="" class="label">Company</label>
      <div class="control">
        <input class="input" type="text" placeholder="Your Company">
      </div>
    </div>
    <div class="columns">
      <div class="column">
        <div class="field">
          <label for="firstName" class="label" name>Fisrt Name</label>
          <div class="control">
            <input class="input" name="firstName" type="text" placeholder="First Name">
          </div>
        </div>
      </div>
      <div class="column">
        <div class="field">
          <label for="lastName" class="label">Last Name</label>
          <div class="control">
            <input class="input" name="lastName" type="text" placeholder="Last Name">
          </div>
        </div>
      </div>
    </div>
    <div class="field">
      <label for="email" class="label">Email</label>
      <div class="control">
        <input class="input" name="email" type="email" placeholder="example@gmail.com">
      </div>
    </div>
    <div class="field">
      <div class="control">
        <button type="submit" class="button is-link">Submit</button>
      </div>
    </div>
  </form>
</section>
<script src="/js/form.js"></script>
<script src="/js/anim.js"></script>
<%- include('../partials/footer'); %>
