<!DOCTYPE html>
<!-- <html lang="en" data-theme="light"> -->
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/validate.js/0.13.1/validate.min.js"></script>
</head>
<body>
  <section class="section">
    <nav class="navbar" role="navigation" aria-label="main navigation">
      <div class="navbar-brand">
        <figure class="image is-64x64 is-flex is-justify-content-center">
          <img src="/res/logo.svg" alt="">
        </figure>
      </div>
      <div class="navbar-start">
        <% navSection.left.links.forEach((link) => { %>
          <a href="<%= link.href %>" class="navbar-item"><%= link.text %></a>
        <% }); %>
      </div>
      <div class="navbar-end">
        <% navSection.right.links.forEach((link) => { %>
          <a href="<%= link.href %>" class="navbar-item"><%= link.text %></a>
        <% }); %>
      </div>
    </nav>
  </section>
